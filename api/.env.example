# ==============================================================================
# IKSHOVIA Data API - Environment Configuration
# ==============================================================================

# Database Configuration
# Async connection URL for FastAPI / SQLAlchemy async engine
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ikshovia

# Synchronous connection URL for Alembic migrations
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ikshovia

# Application Environment (development, staging, production, testing)
APP_ENV=development
DEBUG=true

# API Routing Prefix
API_V1_PREFIX=/api/v1

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
