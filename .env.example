# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_PROVIDER="gemini"
GEMINI_MODEL="gemini-2.5-flash"

# Knowledge Retrieval Tuning Parameters
KNOWLEDGE_STRONG_SCORE_THRESHOLD=0.65
KNOWLEDGE_WEAK_SCORE_THRESHOLD=0.30
KNOWLEDGE_MAX_CONTEXT_ITEMS=5
KNOWLEDGE_MAX_SNIPPET_LENGTH=450


# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Configuration
# In production (Render, Cloud Run, Supabase, Neon, etc.), DATABASE_URL is required.
DATABASE_URL=
POSTGRES_URL=
SUPABASE_DB_URL=

# Supabase Credentials (optional / fallback)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
AUTH_SECRET=
PORT=3000

# Payment Gateway (Razorpay) Configuration
# Required for real transaction processing. If omitted, the application safely
# notifies the user and disables order checkout while preserving all catalog data.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Drive Integration (Admin Resource Library Storage)
# Required for storing syllabus documents, PDF books, and notes on dedicated IKSHOVIA Google Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ikshovia.onrender.com/api/auth/google/callback

# OCR Pipeline Version: "v1" (stable deterministic pipeline, default) or "v2" (experimental background queue)
OCR_PIPELINE_VERSION=v1

